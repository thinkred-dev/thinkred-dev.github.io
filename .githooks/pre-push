#!/usr/bin/env bash
# pre-push guard for the public GitHub remote.
# Blocks a push to GitHub unless:
#   - only refs/heads/main is being pushed (no draft branches, no tags)
#   - every new commit's author AND committer email is the thinkred-dev noreply address
#   - every new commit is signed
# Pushes to Forgejo (origin) are not checked.
set -euo pipefail

remote_name="$1"
remote_url="$2"
expected_email="353098559+thinkred-dev@users.noreply.github.com"
zero="0000000000000000000000000000000000000000"

case "$remote_url" in
  *github*) ;;          # check pushes to GitHub
  *) exit 0 ;;          # anything else (Forgejo) passes through
esac

fail=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && { echo "✗ refusing to delete $remote_ref on GitHub"; fail=1; continue; }

  if [ "$remote_ref" != "refs/heads/main" ]; then
    echo "✗ only main may be pushed to GitHub (attempted: $remote_ref)"
    fail=1; continue
  fi

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  for c in $(git rev-list "$range"); do
    short=$(git rev-parse --short "$c")
    ae=$(git log -1 --format=%ae "$c")
    ce=$(git log -1 --format=%ce "$c")
    if [ "$ae" != "$expected_email" ] || [ "$ce" != "$expected_email" ]; then
      echo "✗ $short has author <$ae> / committer <$ce>; expected <$expected_email>"
      fail=1
    fi
    if ! git cat-file commit "$c" | grep -q '^gpgsig'; then
      echo "✗ $short is not signed"
      fail=1
    fi
  done
done

if [ "$fail" -ne 0 ]; then
  echo
  echo "Push to $remote_name blocked by .githooks/pre-push."
  echo "Fix with: git rebase -i --exec 'git commit --amend --no-edit --reset-author -S' <base>"
  exit 1
fi
echo "✓ pre-push: main only, identity and signatures OK"
